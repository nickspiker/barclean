/target

# Android build outputs. The Rust .so is generated into android/app/libs by
# build-android.sh, so it is a build artifact rather than a checked-in binary.
/android/app/libs/
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties

# Corpus output — regenerated by `cargo run --bin corpus`, never reviewed by hand.
/corpus/out/
